<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>ReadmeShots</AssemblyName>
    <RootNamespace>ReadmeShots</RootNamespace>
    <Product>AI-Usage</Product>
    <EnableSourceControlManagerQueries>false</EnableSourceControlManagerQueries>
    <!-- A build helper that is run by hand, never published: keep it out of the app's own output. -->
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\AiUsage\AiUsage.csproj" />
  </ItemGroup>

</Project>
