<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="clr-namespace:AiUsage.Views.Controls">
    <!-- A plain ResourceDictionary, not a compiled UserControl page - see CollapsibleSection.xaml.cs
         for why. StatsWindow.xaml merges this into its own Window.Resources; the implicit
         (unkeyed) Style below then applies to every CollapsibleSection used there. -->
    <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    <controls:NullIfEmptyStringConverter x:Key="NullIfEmpty"/>

    <!-- Borderless, full-row clickable header - same shape as ProviderTile.xaml's own
         TileNameButtonStyle (a name that doubles as a button): no border, the whole row is the hit
         target rather than just the chevron or the title. The hover background is drawn by the
         header bar around the button and the optional header content, see HeaderBarStyle. -->
    <Style x:Key="SectionHeaderButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="Padding" Value="4"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="HeaderRoot" Background="{TemplateBinding Background}"
                            CornerRadius="{StaticResource Radius.Control}" Padding="{TemplateBinding Padding}">
                        <ContentPresenter/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Quiet hover background over the whole header (button and header content alike), so the
         highlight is as wide as the card below it. -->
    <Style x:Key="HeaderBarStyle" TargetType="Border">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="CornerRadius" Value="{StaticResource Radius.Control}"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource Bg.Raised}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- The chevron follows IsExpanded: down while collapsed (there is more to reveal below), up
         while expanded - the same two geometries TitleBar.xaml's own collapse button already
         switches between. -->
    <Style x:Key="ChevronStyle" TargetType="Path">
        <Setter Property="Data" Value="{StaticResource Icon.ChevronDown}"/>
        <Setter Property="Fill" Value="{DynamicResource Text.Secondary}"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}}" Value="True">
                <Setter Property="Data" Value="{StaticResource Icon.ChevronUp}"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- The dampened summary: shown only while collapsed - the inverse of StatsWindow.xaml's own
         DayDetailHint style, which shows a hint only until real content takes over. -->
    <Style x:Key="SummaryStyle" TargetType="TextBlock">
        <Setter Property="Visibility" Value="Collapsed"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}}" Value="False">
                <Setter Property="Visibility" Value="Visible"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="{x:Type controls:CollapsibleSection}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:CollapsibleSection}">
                    <DockPanel LastChildFill="True">
                        <Border DockPanel.Dock="Top" Style="{StaticResource HeaderBarStyle}">
                        <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Button x:Name="PART_HeaderButton" Grid.Column="0" Style="{StaticResource SectionHeaderButtonStyle}"
                                AutomationProperties.Name="{Binding Title, RelativeSource={RelativeSource TemplatedParent}}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Path Grid.Column="0" Width="10" Height="10" Stretch="Uniform" VerticalAlignment="Center"
                                      Margin="0,0,8,0" Style="{StaticResource ChevronStyle}"/>
                                <!-- The tooltip lives on this heading text alone, not on the button or the
                                     card around it, so it only shows while the pointer is actually over the
                                     heading - Placement=Bottom opens it directly under this element rather
                                     than wherever the header button's own bounds happen to end. -->
                                <TextBlock Grid.Column="1" Text="{Binding Title, RelativeSource={RelativeSource TemplatedParent}}"
                                           FontWeight="SemiBold" VerticalAlignment="Center"
                                           Foreground="{DynamicResource Text.Primary}" FontFamily="{DynamicResource Font.Ui}"
                                           ToolTipService.Placement="Bottom"
                                           ToolTip="{Binding HeaderToolTip, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource NullIfEmpty}}"/>
                                <TextBlock Grid.Column="2" Text="{Binding Summary, RelativeSource={RelativeSource TemplatedParent}}"
                                           Style="{StaticResource SummaryStyle}" Foreground="{DynamicResource Text.Muted}"
                                           FontFamily="{DynamicResource Font.Ui}" FontSize="{StaticResource Font.Size.Small}"
                                           VerticalAlignment="Center" Margin="8,0,0,0" TextTrimming="CharacterEllipsis"/>
                            </Grid>
                        </Button>
                        <ContentPresenter Grid.Column="1" Content="{TemplateBinding HeaderContent}" VerticalAlignment="Center" Margin="8,0,0,0"/>
                        </Grid>
                        </Border>
                        <ContentPresenter x:Name="PART_ContentHost" Margin="0,4,0,0"
                                           Visibility="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource BoolToVis}}"/>
                    </DockPanel>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
