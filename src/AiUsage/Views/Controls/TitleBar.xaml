<UserControl x:Class="AiUsage.Views.Controls.TitleBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:services="clr-namespace:AiUsage.Services"
             xmlns:local="clr-namespace:AiUsage.Views.Controls"
             mc:Ignorable="d" d:DesignWidth="340" MinHeight="32">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <!-- {Binding Source={x:Static services:LocalizationService.Instance}, Path=[Key]} everywhere
             below: the indexer binding re-evaluates every such binding at once the instant
             LocalizationService raises its "Item[]" change, no window recreation needed. -->
        <!-- The icon takes the button's own Foreground, so the hover trigger below brightens the
             drawing exactly the way it used to brighten the glyph. -->
        <Style x:Key="TitleBarIcon" TargetType="Path">
            <Setter Property="Width" Value="16"/>
            <Setter Property="Height" Value="16"/>
            <Setter Property="Stretch" Value="Uniform"/>
            <Setter Property="Fill" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
        </Style>
        <Style x:Key="TitleBarButton" TargetType="Button">
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{DynamicResource Text.Secondary}"/>
            <Setter Property="FontFamily" Value="{DynamicResource Font.Ui}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource Bg.Raised}"/>
                                <Setter Property="Foreground" Value="{DynamicResource Text.Primary}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <!-- Border, not Grid: this is the one element that actually paints the title bar's background, so
         it is also the one that must carry the top corner radius - a Grid has no CornerRadius
         property. The drag/context-menu handlers move here with it, so the whole area stays hit-test
         visible (a plain Grid below with no background of its own would leave the gaps between its
         children unable to catch the mouse). -->
    <Border Background="{DynamicResource Bg.Surface}" CornerRadius="{StaticResource Radius.Window.Top}"
            MouseLeftButtonDown="TitleArea_MouseLeftButtonDown"
            ContextMenuOpening="TitleGrid_ContextMenuOpening">
        <!-- The window menu AllowsTransparency=True cost the app: right-click or Alt+Space (see
             MainWindow's PreviewKeyDown) opens it, ContextMenuOpening below refuses it entirely for
             every window that leaves ShowWindowMenu at its default of False. Only entries the app
             actually supports - no "Move" or "Size", meaningless without the native resize loop. -->
        <Border.ContextMenu>
            <ContextMenu x:Name="WindowMenu">
                <MenuItem Header="{Binding Source={x:Static services:LocalizationService.Instance}, Path=[TitleBar.Minimize]}"
                          Click="MinimizeButton_Click"/>
                <MenuItem x:Name="CollapseMenuItem" Click="CollapseMenuItem_Click"/>
                <MenuItem x:Name="AlwaysOnTopMenuItem" IsCheckable="True"
                          Header="{Binding Source={x:Static services:LocalizationService.Instance}, Path=[Tray.AlwaysOnTop]}"
                          Click="AlwaysOnTopMenuItem_Click"/>
                <MenuItem Header="{Binding Source={x:Static services:LocalizationService.Instance}, Path=[TitleBar.Close]}"
                          Click="CloseButton_Click"/>
            </ContextMenu>
        </Border.ContextMenu>
        <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <!-- Title lives here, in an Auto/* nested Grid so the icon stays fixed and the title takes
             the rest of the space, trimming itself as the window narrows. -->
        <Grid Grid.Column="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <!-- The product mark (Themes/Icons.xaml's AppMarkImage), not the .ico: downsampling the
                 256 px mark stays crisp at every DPI, upscaling the nearest smaller .ico frame does not. -->
            <Image Grid.Column="0" Width="20" Height="20" Margin="8,0,8,0" VerticalAlignment="Center"
                   RenderOptions.BitmapScalingMode="HighQuality" SnapsToDevicePixels="True"
                   Source="{StaticResource AppMarkImage}"/>
            <TextBlock Grid.Column="1" Text="{Binding TitleText, RelativeSource={RelativeSource AncestorType=UserControl}}"
                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                       Foreground="{DynamicResource Text.Primary}"
                       FontFamily="{DynamicResource Font.Ui}" FontSize="{StaticResource Font.Size.Body}" FontWeight="SemiBold"/>
        </Grid>
        <StackPanel Grid.Column="1" Orientation="Horizontal">
            <Button x:Name="EyeButton" Style="{StaticResource TitleBarButton}" Click="EyeButton_Click"
                    Visibility="{Binding ShowEyeMenu, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVis}}"
                    ToolTip="{Binding Source={x:Static services:LocalizationService.Instance}, Path=[Eye.Menu]}"
                    AutomationProperties.Name="{Binding EyeSource.EyeButtonAccessibleName, RelativeSource={RelativeSource AncestorType=UserControl}}">
                <Path Style="{StaticResource TitleBarIcon}" Data="{StaticResource Icon.Layout}"/>
            </Button>
            <Popup x:Name="EyePopup" PlacementTarget="{Binding ElementName=EyeButton}" Placement="Bottom" StaysOpen="False"
                   AllowsTransparency="True" Focusable="True" Opened="EyePopup_Opened" Closed="EyePopup_Closed" KeyDown="EyePopup_KeyDown"
                   DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                <Grid Margin="16">
                <Border x:Name="EyePopupContent" Focusable="True" FocusVisualStyle="{x:Null}" Background="{DynamicResource Bg.Surface}" BorderBrush="{DynamicResource Border}" BorderThickness="1"
                        CornerRadius="{StaticResource Radius.Control}" Padding="{StaticResource Space.S}" MinWidth="190">
                    <Border.Effect>
                        <DropShadowEffect Color="{DynamicResource Shadow}" BlurRadius="12" ShadowDepth="2" Opacity="1"/>
                    </Border.Effect>
                    <StackPanel>
                        <!-- DisplayRows, not Tiles: the same mixed provider-plus-day-grid order the
                             main window itself shows, so this popup lists exactly what is on
                             screen, in the order it is on screen. The row template below binds
                             every member by plain property name (ProviderId, HeaderDisplayName,
                             IsHidden, CanMoveUp, CanMoveDown, ToggleVisibilityActionText) - both
                             ProviderTileViewModel and DayGridTileViewModel already expose the exact
                             same set through ITileRow plus their own matching members, so this one
                             template renders either kind without a type check anywhere here. -->
                        <ItemsControl ItemsSource="{Binding DisplayRows}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <!-- 8px below every row (the spacing scale's own step above the 4px
                                         gap between the three buttons themselves), so rows read as
                                         separate providers instead of one dense block. -->
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Button Grid.Column="0"
                                                Command="{Binding DataContext.ToggleHiddenCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding ProviderId}"
                                                ToolTip="{Binding ToggleVisibilityActionText}"
                                                AutomationProperties.Name="{Binding ToggleVisibilityActionText}"
                                                Style="{StaticResource AiUsageQuietButton}"
                                                Padding="4,4" MinHeight="32"
                                                HorizontalContentAlignment="Left" Cursor="Hand">
                                            <StackPanel Orientation="Horizontal">
                                                <Path Width="18" Height="14" Stretch="Uniform" Margin="0,0,8,0"
                                                      Fill="{DynamicResource Text.Primary}">
                                                    <Path.Style>
                                                        <Style TargetType="Path">
                                                            <Setter Property="Data" Value="{StaticResource Icon.Eye}"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsHidden}" Value="True">
                                                                    <Setter Property="Data" Value="{StaticResource Icon.EyeOff}"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Path.Style>
                                                </Path>
                                                <TextBlock Text="{Binding HeaderDisplayName}" VerticalAlignment="Center"
                                                           Foreground="{DynamicResource Text.Primary}"
                                                           FontFamily="{DynamicResource Font.Ui}" FontSize="{StaticResource Font.Size.Body}"/>
                                            </StackPanel>
                                        </Button>
                                        <!-- Reorder arrows: drag-and-drop was considered and dropped - dragging inside this
                                             frameless window would fight the window's own drag-move gesture (see TitleArea_MouseLeftButtonDown). -->
                                        <Button Grid.Column="1" Style="{StaticResource AiUsageQuietButton}"
                                                Padding="4,4" MinHeight="32" MinWidth="28" Margin="4,0,0,0" HorizontalContentAlignment="Center" Cursor="Hand"
                                                Command="{Binding DataContext.MoveProviderUpCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding ProviderId}"
                                                IsEnabled="{Binding CanMoveUp}"
                                                ToolTip="{Binding Source={x:Static services:LocalizationService.Instance}, Path=[Eye.MoveUp]}"
                                                AutomationProperties.Name="{Binding Source={x:Static services:LocalizationService.Instance}, Path=[Eye.MoveUp]}">
                                            <Path Width="12" Height="12" Stretch="Uniform" Data="{StaticResource Icon.ArrowUp}" Fill="{DynamicResource Text.Primary}"/>
                                        </Button>
                                        <Button Grid.Column="2" Style="{StaticResource AiUsageQuietButton}"
                                                Padding="4,4" MinHeight="32" MinWidth="28" Margin="4,0,0,0" HorizontalContentAlignment="Center" Cursor="Hand"
                                                Command="{Binding DataContext.MoveProviderDownCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding ProviderId}"
                                                IsEnabled="{Binding CanMoveDown}"
                                                ToolTip="{Binding Source={x:Static services:LocalizationService.Instance}, Path=[Eye.MoveDown]}"
                                                AutomationProperties.Name="{Binding Source={x:Static services:LocalizationService.Instance}, Path=[Eye.MoveDown]}">
                                            <Path Width="12" Height="12" Stretch="Uniform" Data="{StaticResource Icon.ArrowDown}" Fill="{DynamicResource Text.Primary}"/>
                                        </Button>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Separator Margin="0,8"/>
                        <TextBlock Text="{Binding Source={x:Static services:LocalizationService.Instance}, Path=[Settings.TileDensity]}"
                                   FontWeight="SemiBold" FontSize="{StaticResource Font.Size.Small}" Margin="0,0,0,4"
                                   Foreground="{DynamicResource Text.Secondary}" FontFamily="{DynamicResource Font.Ui}"/>
                        <ComboBox ItemsSource="{Binding DensityChoices}"
                                  SelectedItem="{Binding SelectedDensityChoice, Mode=TwoWay}"
                                  AutomationProperties.Name="{Binding Source={x:Static services:LocalizationService.Instance}, Path=[Settings.TileDensity]}"
                                  FontFamily="{DynamicResource Font.Ui}" FontSize="{StaticResource Font.Size.Body}"/>

                        <Separator Margin="0,8"/>
                        <CheckBox Content="{Binding Source={x:Static services:LocalizationService.Instance}, Path=[Window.AutoHeight]}"
                                  IsChecked="{Binding HeightAutomatic}" Margin="0,0,0,8"
                                  Foreground="{DynamicResource Text.Primary}" FontFamily="{DynamicResource Font.Ui}" FontSize="{StaticResource Font.Size.Body}"/>
                        <CheckBox Content="{Binding Source={x:Static services:LocalizationService.Instance}, Path=[Window.AutoWidth]}"
                                  IsChecked="{Binding WidthAutomatic}" Margin="0,0"
                                  Foreground="{DynamicResource Text.Primary}" FontFamily="{DynamicResource Font.Ui}" FontSize="{StaticResource Font.Size.Body}"/>
                    </StackPanel>
                </Border>
                </Grid>
            </Popup>
            <Button x:Name="RefreshButton" Style="{StaticResource TitleBarButton}"
                    Click="RefreshButton_Click"
                    Visibility="{Binding ShowRefresh, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVis}}"
                    ToolTip="{Binding Source={x:Static services:LocalizationService.Instance}, Path=[Action.RefreshNow]}"
                    AutomationProperties.Name="{Binding Source={x:Static services:LocalizationService.Instance}, Path=[Action.RefreshNow]}">
                <local:RefreshGlyph Width="16" Height="16"
                                    Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                    IsSpinning="{Binding EyeSource.IsAnyFetching, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
            </Button>
            <Button x:Name="StatsButton" Style="{StaticResource TitleBarButton}"
                    Click="StatsButton_Click"
                    Visibility="{Binding ShowStats, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVis}}"
                    ToolTip="{Binding Source={x:Static services:LocalizationService.Instance}, Path=[Tray.Stats]}"
                    AutomationProperties.Name="{Binding Source={x:Static services:LocalizationService.Instance}, Path=[Tray.Stats]}">
                <Path Style="{StaticResource TitleBarIcon}" Data="{StaticResource Icon.Stats}"/>
            </Button>
            <Button x:Name="SettingsButton" Style="{StaticResource TitleBarButton}"
                    Click="SettingsButton_Click"
                    Visibility="{Binding ShowSettings, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVis}}"
                    ToolTip="{Binding Source={x:Static services:LocalizationService.Instance}, Path=[Tray.Settings]}"
                    AutomationProperties.Name="{Binding Source={x:Static services:LocalizationService.Instance}, Path=[Tray.Settings]}">
                <Path Style="{StaticResource TitleBarIcon}" Data="{StaticResource Icon.Gear}"/>
            </Button>
            <Button x:Name="MinimizeButton" Style="{StaticResource TitleBarButton}"
                    Click="MinimizeButton_Click"
                    Visibility="{Binding ShowMinimize, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVis}}"
                    AutomationProperties.Name="{Binding Source={x:Static services:LocalizationService.Instance}, Path=[TitleBar.Minimize]}">
                <Path Style="{StaticResource TitleBarIcon}" Data="{StaticResource Icon.Minimize}"/>
            </Button>
            <Button x:Name="CloseButton" Style="{StaticResource TitleBarButton}"
                    Click="CloseButton_Click"
                    AutomationProperties.Name="{Binding Source={x:Static services:LocalizationService.Instance}, Path=[TitleBar.Close]}">
                <Path Style="{StaticResource TitleBarIcon}" Data="{StaticResource Icon.Close}"/>
            </Button>
        </StackPanel>
        </Grid>
    </Border>
</UserControl>
