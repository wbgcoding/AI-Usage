<Window x:Class="AiUsage.Views.ConfirmWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:AiUsage.Views.Controls"
        Icon="pack://application:,,,/AI-Usage;component/Assets/app.ico"
        RenderOptions.BitmapScalingMode="HighQuality"
        WindowStyle="None"
        Background="{DynamicResource Bg.Window}"
        FontFamily="{DynamicResource Font.Ui}"
        Width="356" MinWidth="356" SizeToContent="Height"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Foreground="{DynamicResource Text.Primary}">
    <Window.Resources>
        <!-- The progress bar of a work dialog: a filled bar for a known share, a moving block while
             the share is not known. Same track and fill colors as the loading bar of the sign-in
             window; the bar is 8px high, half of which is the corner radius. -->
        <CornerRadius x:Key="WorkBarRadius">4</CornerRadius>
        <Style x:Key="WorkProgressBarStyle" TargetType="ProgressBar">
            <Setter Property="Height" Value="8"/>
            <Setter Property="Maximum" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid>
                            <Border x:Name="PART_Track" Background="{DynamicResource Track}" CornerRadius="{StaticResource WorkBarRadius}"
                                    BorderBrush="{DynamicResource Border.Control}" BorderThickness="1" ClipToBounds="True">
                                <Border x:Name="PART_Indicator" HorizontalAlignment="Left" Background="{DynamicResource Accent}"
                                        CornerRadius="{StaticResource WorkBarRadius}"/>
                            </Border>
                            <Border x:Name="MovingBlock" Visibility="Collapsed" ClipToBounds="True" CornerRadius="{StaticResource WorkBarRadius}">
                                <Rectangle Width="70" RadiusX="4" RadiusY="4" HorizontalAlignment="Left" Fill="{DynamicResource Accent}">
                                    <Rectangle.RenderTransform>
                                        <TranslateTransform x:Name="MovingTransform" X="-70"/>
                                    </Rectangle.RenderTransform>
                                </Rectangle>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsIndeterminate" Value="True">
                                <Setter TargetName="PART_Track" Property="Visibility" Value="Hidden"/>
                                <Setter TargetName="MovingBlock" Property="Visibility" Value="Visible"/>
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard Timeline.DesiredFrameRate="60">
                                            <DoubleAnimation Storyboard.TargetName="MovingTransform" Storyboard.TargetProperty="X"
                                                             From="-70" To="320" Duration="0:0:1.2" RepeatBehavior="Forever"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Border x:Name="ChromeBorder" Style="{StaticResource WindowChrome}">
        <DockPanel LastChildFill="True">
            <DockPanel.Resources>
                <BooleanToVisibilityConverter x:Key="BoolToVis"/>
            </DockPanel.Resources>
            <controls:TitleBar x:Name="TitleBarControl" DockPanel.Dock="Top" ShowEyeMenu="False" ShowRefresh="False"
                               ShowSettings="False" ShowMinimize="False" AllowCollapse="False"
                               CloseRequested="TitleBarControl_CloseRequested"/>
            <StackPanel Margin="{StaticResource Space.Xl}">
                <TextBlock x:Name="MessageText" Text="{Binding Message}" TextWrapping="Wrap" FontSize="{StaticResource Font.Size.Body}"
                           Foreground="{DynamicResource Text.Primary}"/>
                <!-- A technical line the user can select and copy into a report; hidden unless a
                     caller passes one. -->
                <TextBox x:Name="DetailBox" Visibility="Collapsed" IsReadOnly="True" BorderThickness="0"
                         Background="Transparent" Padding="0" Margin="0,12,0,0" TextWrapping="Wrap"
                         FontSize="{StaticResource Font.Size.Small}" Foreground="{DynamicResource Text.Secondary}"/>
                <!-- Only shown while a work dialog (see RunWithProgress) is running. -->
                <ProgressBar x:Name="WorkProgress" Visibility="Collapsed" Style="{StaticResource WorkProgressBarStyle}"
                             Margin="0,12,0,0" AutomationProperties.Name="{Binding Message}"/>
                <CheckBox IsChecked="{Binding ExtraOptionChecked, Mode=TwoWay}"
                          AutomationProperties.Name="{Binding ExtraOptionText}"
                          Foreground="{DynamicResource Text.Primary}" Margin="0,12,0,0"
                          Visibility="{Binding ShowExtraOption, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="{Binding ExtraOptionText}" TextWrapping="Wrap"/>
                </CheckBox>
                <!-- One row, never wrapped: a wide font (the Terminal theme) widens the window
                     instead, see FitWidthToButtons. The labels are set in code so they can be
                     measured before the window shows. -->
                <StackPanel x:Name="ButtonRow" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,24,0,0">
                    <Button x:Name="ConfirmButton" Style="{StaticResource AiUsageButton}" Padding="16,4" Margin="0,0,8,0" AutomationProperties.Name="{Binding ConfirmText}"
                            Click="ConfirmButton_Click"/>
                    <Button x:Name="CancelButton" Style="{StaticResource AiUsageButton}" Padding="16,4"
                            IsCancel="True" IsDefault="True" AutomationProperties.Name="{Binding CancelText}" Click="CancelButton_Click"/>
                </StackPanel>
            </StackPanel>
        </DockPanel>
    </Border>
</Window>
