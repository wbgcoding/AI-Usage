<Window x:Class="AiUsage.Views.CrashWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:AiUsage.Views.Controls"
        xmlns:services="clr-namespace:AiUsage.Services"
        Icon="pack://application:,,,/AI-Usage;component/Assets/app.ico"
        RenderOptions.BitmapScalingMode="HighQuality"
        WindowStyle="None"
        Background="{DynamicResource Bg.Window}"
        FontFamily="{DynamicResource Font.Ui}"
        Width="496" SizeToContent="Height"
        ResizeMode="NoResize"
        ShowInTaskbar="True"
        WindowStartupLocation="CenterScreen"
        Topmost="True"
        Foreground="{DynamicResource Text.Primary}">
    <!-- Every app-level resource here is a DynamicResource: this dialog exists for exactly the case
         where the app dictionaries may have failed to load, and a missing StaticResource would throw
         while the crash dialog itself is being built. The code-behind seeds fallbacks for the keys
         the layout cannot do without. -->
    <Border x:Name="ChromeBorder" Style="{DynamicResource WindowChrome}">
        <DockPanel LastChildFill="True">
            <controls:TitleBar x:Name="TitleBarControl" DockPanel.Dock="Top" ShowEyeMenu="False" ShowRefresh="False"
                               ShowSettings="False" ShowMinimize="False" AllowCollapse="False"
                               CloseRequested="TitleBarControl_CloseRequested"/>
            <Grid Margin="{DynamicResource Space.Xl}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock x:Name="HeadlineText" Grid.Row="0" FontSize="{DynamicResource Font.Size.Title}" FontWeight="SemiBold"
                   Foreground="{DynamicResource Text.Primary}" TextWrapping="Wrap"/>
        <TextBlock x:Name="MessageText" Grid.Row="1" FontSize="{DynamicResource Font.Size.Body}" Foreground="{DynamicResource Text.Secondary}"
                   TextWrapping="Wrap" Margin="0,8,0,8"/>
        <TextBox x:Name="DetailsBox" Grid.Row="2" IsReadOnly="True" TextWrapping="NoWrap" AcceptsReturn="True"
                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                 MinHeight="160" MaxHeight="360" FontFamily="{DynamicResource Font.Mono}" FontSize="{DynamicResource Font.Size.Micro}"
                 Background="{DynamicResource Bg.Raised}" Foreground="{DynamicResource Text.Primary}"
                 BorderThickness="1" BorderBrush="{DynamicResource Border.Control}"/>
        <WrapPanel Grid.Row="3" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button x:Name="CopyDetailsButton" Style="{DynamicResource AiUsageButton}" Padding="8,4" Margin="0,0,8,0"
                    Click="CopyDetails_Click"
                    Content="{Binding Source={x:Static services:LocalizationService.Instance}, Path=[Crash.CopyDetails]}"/>
            <Button x:Name="OpenLogFolderButton" Style="{DynamicResource AiUsageButton}" Padding="8,4" Margin="0,0,8,0"
                    Click="OpenLogFolder_Click"
                    Content="{Binding Source={x:Static services:LocalizationService.Instance}, Path=[Crash.OpenLogFolder]}"/>
            <Button x:Name="CloseButton" Style="{DynamicResource AiUsageButton}" Padding="8,4"
                    Click="Close_Click" IsDefault="True" IsCancel="True"
                    Content="{Binding Source={x:Static services:LocalizationService.Instance}, Path=[Crash.Close]}"/>
                </WrapPanel>
            </Grid>
        </DockPanel>
    </Border>
</Window>
