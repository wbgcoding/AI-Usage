<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Light. -->
    <SolidColorBrush x:Key="Bg.Base" Color="#F1F2F6"/>
    <SolidColorBrush x:Key="Bg.Surface" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="Bg.Raised" Color="#F6F7FA"/>
    <SolidColorBrush x:Key="Border" Color="#D5D6DE"/>
    <SolidColorBrush x:Key="Border.Window" Color="#E4E4EA"/>
    <SolidColorBrush x:Key="Border.Control" Color="#8888A0"/>
    <SolidColorBrush x:Key="Track" Color="#DFE0E7"/>
    <Thickness x:Key="Track.BorderThickness">0</Thickness>
    <SolidColorBrush x:Key="Text.Primary" Color="#101828"/>
    <SolidColorBrush x:Key="Text.Secondary" Color="#4B5060"/>
    <SolidColorBrush x:Key="Text.Muted" Color="#676C7A"/>
    <SolidColorBrush x:Key="Accent" Color="#2563EB"/>
    <SolidColorBrush x:Key="Accent.Hover" Color="#1D4ED8"/>
    <SolidColorBrush x:Key="Level.Ok" Color="#059065"/>
    <SolidColorBrush x:Key="Level.Warn" Color="#B45309"/>
    <SolidColorBrush x:Key="Level.Crit" Color="#DC2626"/>
    <!-- Usage bar fill: same flat level color at the left, 15% lighter at the right. -->
    <LinearGradientBrush x:Key="Level.Ok.Fill" StartPoint="0,0.5" EndPoint="1,0.5">
        <GradientStop Color="#059065" Offset="0"/>
        <GradientStop Color="#2BA17C" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="Level.Warn.Fill" StartPoint="0,0.5" EndPoint="1,0.5">
        <GradientStop Color="#B45309" Offset="0"/>
        <GradientStop Color="#BF6D2E" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="Level.Crit.Fill" StartPoint="0,0.5" EndPoint="1,0.5">
        <GradientStop Color="#DC2626" Offset="0"/>
        <GradientStop Color="#E14747" Offset="1"/>
    </LinearGradientBrush>
    <Color x:Key="Shadow">#1F101828</Color>
    <!-- WPF's text stack mismeasures the OS's newer, variable-weight Segoe build and clips
         descenders (g, j, y, q) in a TextBox; the classic static Segoe UI renders those correctly. -->
    <FontFamily x:Key="Font.Ui">Segoe UI, Arial</FontFamily>
    <FontFamily x:Key="Font.Numeric">Segoe UI, Arial</FontFamily>
</ResourceDictionary>
