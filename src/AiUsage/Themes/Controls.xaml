<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:services="clr-namespace:AiUsage.Services"
                    xmlns:system="clr-namespace:System;assembly=mscorlib">
    <!-- Control templates that read theme tokens exclusively via DynamicResource, so a theme swap
         (Services/ThemeService.cs) restyles every control without recreating a window. Controls that
         only ever appear in one place keep their style local to that UserControl's Resources
         (TitleBar.xaml, ProviderTile.xaml, UsageBar.xaml); everything below is either shared by
         several views or a standard control whose native look does not belong in this window. -->
    <!-- Implicit styles (TargetType only, no key): every standard control the app uses is drawn from
         theme tokens, because the native chrome is light and sat in the middle of a dark window as
         white circles, white boxes and a white scroll bar. Each keeps a one pixel Accent focus ring
         so keyboard users still see where they are. -->
    <Style TargetType="RadioButton">
        <Setter Property="Foreground" Value="{DynamicResource Text.Primary}"/>
        <Setter Property="FontFamily" Value="{DynamicResource Font.Ui}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Padding" Value="8,0,0,0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <!-- TextElement.Foreground here, not left to inherit: a plain-string Content
                         renders through an auto-generated TextBlock that does not reliably pick up
                         the control's own Foreground once a custom template is in play. -->
                    <!-- A DockPanel rather than a horizontal StackPanel: the content gets the remaining
                         width, so a wrapping label can wrap instead of running off the edge. -->
                    <DockPanel Background="Transparent" TextElement.Foreground="{TemplateBinding Foreground}">
                        <!-- Plain string content: an AccessText (the access key underline still works)
                             that wraps. The default one never wraps, so a wide font (the Terminal
                             theme) cut long labels off at the window edge. Keyed by type, so content
                             that is already an element (a TextBlock of its own) is left alone. -->
                        <DockPanel.Resources>
                            <DataTemplate DataType="{x:Type system:String}">
                                <AccessText Text="{Binding}" TextWrapping="Wrap"/>
                            </DataTemplate>
                        </DockPanel.Resources>
                        <Grid DockPanel.Dock="Left" Width="16" Height="16" VerticalAlignment="Center">
                            <Ellipse x:Name="Ring" Stroke="{DynamicResource Border.Control}" StrokeThickness="1"
                                     Fill="{DynamicResource Bg.Raised}"/>
                            <Ellipse x:Name="Dot" Width="8" Height="8" Fill="{DynamicResource Accent}" Visibility="Collapsed"/>
                            <Ellipse x:Name="Focus" Stroke="{DynamicResource Accent}" StrokeThickness="1" Visibility="Collapsed"/>
                        </Grid>
                        <ContentPresenter Margin="{TemplateBinding Padding}" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                    </DockPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Dot" Property="Visibility" Value="Visible"/>
                            <Setter TargetName="Ring" Property="Stroke" Value="{DynamicResource Accent}"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Ring" Property="Stroke" Value="{DynamicResource Accent.Hover}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Focus" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="CheckBox">
        <Setter Property="Foreground" Value="{DynamicResource Text.Primary}"/>
        <Setter Property="FontFamily" Value="{DynamicResource Font.Ui}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Padding" Value="8,0,0,0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <!-- A DockPanel rather than a horizontal StackPanel: the content gets the remaining
                         width, so a wrapping label can wrap instead of running off the edge. -->
                    <DockPanel Background="Transparent" TextElement.Foreground="{TemplateBinding Foreground}">
                        <!-- Plain string content: an AccessText (the access key underline still works)
                             that wraps. The default one never wraps, so a wide font (the Terminal
                             theme) cut long labels off at the window edge. Keyed by type, so content
                             that is already an element (a TextBlock of its own) is left alone. -->
                        <DockPanel.Resources>
                            <DataTemplate DataType="{x:Type system:String}">
                                <AccessText Text="{Binding}" TextWrapping="Wrap"/>
                            </DataTemplate>
                        </DockPanel.Resources>
                        <Grid DockPanel.Dock="Left" Width="16" Height="16" VerticalAlignment="Center">
                            <Border x:Name="Box" CornerRadius="{StaticResource Radius.S}" BorderThickness="1"
                                    BorderBrush="{DynamicResource Border.Control}" Background="{DynamicResource Bg.Raised}"/>
                            <Path x:Name="Check" Visibility="Collapsed" Stretch="Uniform" Margin="{StaticResource Space.Xs}"
                                  Stroke="{DynamicResource Bg.Base}" StrokeThickness="2"
                                  StrokeEndLineCap="Round" StrokeStartLineCap="Round"
                                  Data="M 0,5 L 4,9 L 11,1"/>
                            <Border x:Name="Focus" CornerRadius="{StaticResource Radius.S}" BorderThickness="1"
                                    BorderBrush="{DynamicResource Accent}" Visibility="Collapsed"/>
                        </Grid>
                        <ContentPresenter Margin="{TemplateBinding Padding}" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                    </DockPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Box" Property="Background" Value="{DynamicResource Accent}"/>
                            <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                            <Setter TargetName="Check" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Accent.Hover}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Focus" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="SliderThumb" TargetType="Thumb">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Grid Width="14" Height="14">
                        <!-- Margin -3 grows the halo outside the 14 px thumb to form the glow ring:
                             optical offset, not spacing, like the eye-badge corner in TitleBar.xaml. -->
                        <Ellipse x:Name="Halo" Fill="{DynamicResource Accent}" Opacity="0.25" Margin="-3"/>
                        <Ellipse Fill="{DynamicResource Accent}"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="False">
                            <Setter TargetName="Halo" Property="Opacity" Value="0"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="Slider">
        <Setter Property="Foreground" Value="{DynamicResource Accent}"/>
        <Setter Property="MinHeight" Value="20"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Slider">
                    <Grid VerticalAlignment="Center">
                        <!-- CornerRadius 2 on both bars below = half of this 4 px track's own height:
                             geometry, not a design token, so it is not in Tokens.xaml. -->
                        <Border Height="4" CornerRadius="2" Background="{DynamicResource Track}" VerticalAlignment="Center"/>
                        <Track x:Name="PART_Track">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="Slider.DecreaseLarge" AutomationProperties.Name="{Binding Source={x:Static services:LocalizationService.Instance}, Path=[Slider.Decrease]}">
                                    <RepeatButton.Template>
                                        <ControlTemplate TargetType="RepeatButton">
                                            <Border Height="4" CornerRadius="2" Background="{DynamicResource Accent}" VerticalAlignment="Center"/>
                                        </ControlTemplate>
                                    </RepeatButton.Template>
                                </RepeatButton>
                            </Track.DecreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Style="{StaticResource SliderThumb}"/>
                            </Track.Thumb>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="Slider.IncreaseLarge" AutomationProperties.Name="{Binding Source={x:Static services:LocalizationService.Instance}, Path=[Slider.Increase]}">
                                    <RepeatButton.Template>
                                        <ControlTemplate TargetType="RepeatButton">
                                            <Border Background="Transparent"/>
                                        </ControlTemplate>
                                    </RepeatButton.Template>
                                </RepeatButton>
                            </Track.IncreaseRepeatButton>
                        </Track>
                        <Border x:Name="Focus" BorderBrush="{DynamicResource Accent}" BorderThickness="1"
                                CornerRadius="{StaticResource Radius.S}" Visibility="Collapsed"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Focus" Property="Visibility" Value="Visible"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- The invisible resize grips around the frameless window. Without an own template a Thumb draws
         the system's light bevel, and eight of them along the window edges are exactly the white rim
         that made the window look like it had a border. Transparent, not collapsed: the grip still
         has to catch the mouse. -->
    <Style x:Key="ResizeGrip" TargetType="Thumb">
        <Setter Property="Background" Value="Transparent"/>
        <!-- The grips are mouse-only drag handles, not a keyboard control: without this, Tab walks
             through all eight before ever reaching a button. -->
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border Background="{TemplateBinding Background}"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ScrollBarThumb" TargetType="Thumb">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border x:Name="Body" CornerRadius="{StaticResource Radius.S}" Background="{DynamicResource Border}" Margin="0"/>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Body" Property="Background" Value="{DynamicResource Text.Muted}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Eight pixels, no arrow buttons, transparent track: the bar is a hint, not a control panel. -->
    <Style TargetType="ScrollBar">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Width" Value="8"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Grid Background="{TemplateBinding Background}">
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.Thumb>
                                <Thumb Style="{StaticResource ScrollBarThumb}"/>
                            </Track.Thumb>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Width" Value="Auto"/>
                <Setter Property="Height" Value="8"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ScrollBar">
                            <Grid Background="{TemplateBinding Background}">
                                <Track x:Name="PART_Track">
                                    <Track.Thumb>
                                        <Thumb Style="{StaticResource ScrollBarThumb}"/>
                                    </Track.Thumb>
                                </Track>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="Separator">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Separator">
                    <Border Height="1" Background="{DynamicResource Border}"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- The tile's right-click menu (and any future one): the same surface/border tokens as every
         other floating panel in this app, never the native white Windows menu. -->
    <Style TargetType="ContextMenu">
        <Setter Property="Background" Value="{DynamicResource Bg.Surface}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Border}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="4"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContextMenu">
                    <!-- No Effect and no CacheMode, for the same reason the drop-down list carries
                         neither: the drawn shadow forced the whole open menu through an intermediate
                         surface, and BitmapCache then rasterized that surface once and stretched it
                         back, which smeared every label in the menu. The border alone lifts the
                         panel off the window, and the text stays as sharp as the rest of the app. -->
                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{StaticResource Radius.Control}"
                            Padding="{TemplateBinding Padding}">
                        <StackPanel IsItemsHost="True"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="MenuItem">
        <Setter Property="Foreground" Value="{DynamicResource Text.Primary}"/>
        <Setter Property="FontFamily" Value="{DynamicResource Font.Ui}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Padding" Value="12,4"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="MenuItem">
                    <Border x:Name="Root" Background="Transparent" CornerRadius="{StaticResource Radius.S}"
                            Padding="{TemplateBinding Padding}" TextElement.Foreground="{TemplateBinding Foreground}">
                        <!-- The check glyph sits right of the label and only takes room while checked, so
                             the label never shifts and an unchecked menu is no wider than its text. The
                             shortcut text and the submenu arrow sit there too, each only when it has
                             something to show. -->
                        <Grid>
                            <DockPanel>
                                <Path x:Name="CheckGlyph" DockPanel.Dock="Right" Width="12" Height="12" Margin="12,0,0,0"
                                      VerticalAlignment="Center" Data="M2,6 L5,9 L10,3" Stroke="{TemplateBinding Foreground}"
                                      StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                      Visibility="Collapsed"/>
                                <Path x:Name="SubmenuArrow" DockPanel.Dock="Right" Width="8" Height="10" Margin="12,0,0,0"
                                      VerticalAlignment="Center" Data="M2,1 L6,5 L2,9" Stroke="{TemplateBinding Foreground}"
                                      StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                      Visibility="Collapsed"/>
                                <TextBlock x:Name="GestureText" DockPanel.Dock="Right" Margin="24,0,0,0" VerticalAlignment="Center"
                                           Text="{TemplateBinding InputGestureText}" Foreground="{DynamicResource Text.Secondary}"/>
                                <ContentPresenter ContentSource="Header" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                            </DockPanel>
                            <Popup x:Name="PART_Popup" Placement="Right" HorizontalOffset="-2" AllowsTransparency="True" Focusable="False"
                                   PopupAnimation="None" IsOpen="{Binding IsSubmenuOpen, RelativeSource={RelativeSource TemplatedParent}}">
                                <Border Background="{DynamicResource Bg.Surface}" BorderBrush="{DynamicResource Border}" BorderThickness="1"
                                        CornerRadius="{StaticResource Radius.Control}" Padding="4">
                                    <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle"/>
                                </Border>
                            </Popup>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="CheckGlyph" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="InputGestureText" Value="">
                            <Setter TargetName="GestureText" Property="Visibility" Value="Collapsed"/>
                        </Trigger>
                        <Trigger Property="Role" Value="SubmenuHeader">
                            <Setter TargetName="SubmenuArrow" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <!-- IsHighlighted covers both mouse hover and arrow-key selection, so keyboard
                             users see the same feedback a pointer gives. -->
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource Bg.Raised}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ToolTip">
        <Setter Property="Foreground" Value="{DynamicResource Text.Primary}"/>
        <Setter Property="FontFamily" Value="{DynamicResource Font.Ui}"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="HasDropShadow" Value="False"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Placement" Value="Bottom"/>
        <Setter Property="ToolTipService.InitialShowDelay" Value="400"/>
        <Setter Property="ToolTipService.ShowDuration" Value="20000"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToolTip">
                    <Border Background="{DynamicResource Bg.Surface}" BorderBrush="{DynamicResource Border}"
                            BorderThickness="1" CornerRadius="{StaticResource Radius.Control}" Padding="8,4">
                        <ContentPresenter/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="TextBox">
        <Setter Property="Foreground" Value="{DynamicResource Text.Primary}"/>
        <Setter Property="Background" Value="{DynamicResource Bg.Raised}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Border.Control}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CaretBrush" Value="{DynamicResource Text.Primary}"/>
        <Setter Property="SelectionBrush" Value="{DynamicResource Accent}"/>
        <Setter Property="Padding" Value="8,4"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="Frame" CornerRadius="{StaticResource Radius.Control}" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                        <ScrollViewer x:Name="PART_ContentHost" Padding="{TemplateBinding Padding}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Implicit ComboBoxItem style, so the drop-down list inside the ComboBox template below (and any
         other ComboBox this app builds) matches the theme instead of the native white list item. -->
    <Style TargetType="ComboBoxItem">
        <Setter Property="Padding" Value="8,4"/>
        <Setter Property="Foreground" Value="{DynamicResource Text.Primary}"/>
        <Setter Property="FontFamily" Value="{DynamicResource Font.Ui}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="ItemRoot" Background="Transparent" CornerRadius="{StaticResource Radius.S}"
                            Padding="{TemplateBinding Padding}" TextElement.Foreground="{TemplateBinding Foreground}">
                        <ContentPresenter/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="ItemRoot" Property="Background" Value="{DynamicResource Bg.Raised}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="ItemRoot" Property="Background" Value="{DynamicResource Accent}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Built from the same tokens as the controls above: the surface brush for the closed box, the
         border brush for its outline, the accent brush for focus and (through the ComboBoxItem style)
         the selected item, the raised background for the item under the pointer, and the caption
         foreground for the arrow. Same corner radius and padding scale as TextBox above, same popup
         shadow as the other raised surfaces (ContextMenu, ToolTip). -->
    <!-- Every ComboBox in this app is bound to a list of Choice rows, and every one of them shows
         that row's Label. The template is shared rather than repeated per call site, and it is an
         ItemTemplate rather than DisplayMemberPath because only an ItemTemplate also reaches the
         closed selection box (see the ContentPresenter inside the ComboBox template below). -->
    <DataTemplate x:Key="ChoiceLabelTemplate">
        <TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis"/>
    </DataTemplate>

    <Style TargetType="ComboBox">
        <Setter Property="ItemTemplate" Value="{StaticResource ChoiceLabelTemplate}"/>
        <Setter Property="Background" Value="{DynamicResource Bg.Surface}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Border}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Foreground" Value="{DynamicResource Text.Primary}"/>
        <Setter Property="FontFamily" Value="{DynamicResource Font.Ui}"/>
        <Setter Property="Padding" Value="8,4"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <ToggleButton x:Name="Toggle" Focusable="False" ClickMode="Press"
                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                      AutomationProperties.Name="{Binding Path=(AutomationProperties.Name), RelativeSource={RelativeSource AncestorType=ComboBox}}">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border x:Name="Root"
                                            Background="{Binding Background, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                            BorderBrush="{Binding BorderBrush, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                            BorderThickness="{Binding BorderThickness, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                            CornerRadius="{StaticResource Radius.Control}">
                                        <Grid Margin="{Binding Padding, RelativeSource={RelativeSource AncestorType=ComboBox}}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <!-- ContentTemplate is what gives the closed box its text: without it
                                                 the presenter has nothing but the bound object and falls back to
                                                 that object's type name, which is what every ComboBox in this app
                                                 used to show while shut. It follows from the ComboBox's own
                                                 ItemTemplate (see ChoiceLabelTemplate above) - DisplayMemberPath
                                                 alone does not reach here, because the container it would be
                                                 applied to does not exist until the drop-down is opened. -->
                                            <ContentPresenter Grid.Column="0"
                                                              Content="{Binding SelectionBoxItem, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                              ContentTemplate="{Binding SelectionBoxItemTemplate, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                              ContentStringFormat="{Binding SelectionBoxItemStringFormat, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                              TextElement.Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                              VerticalAlignment="Center" HorizontalAlignment="Left"/>
                                            <Path Grid.Column="1" Width="10" Height="10" Stretch="Uniform" Margin="8,0,0,0"
                                                  VerticalAlignment="Center"
                                                  Data="F1 M 12.983,16.313 L 11.017,17.687 L 4.017,7.687 L 5.983,6.313 Z M 11.017,16.313 L 12.983,17.687 L 19.983,7.687 L 18.017,6.313 Z"
                                                  Fill="{DynamicResource Text.Secondary}"/>
                                        </Grid>
                                    </Border>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>
                        <Popup x:Name="Popup" IsOpen="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}}"
                               Placement="Bottom" AllowsTransparency="True" Focusable="False" PopupAnimation="None">
                            <!-- No Effect and no CacheMode: a drawn shadow forces the whole open list
                                 through an intermediate surface, and BitmapCache then rasterized that
                                 surface once at a fixed scale and stretched it - which is what made the
                                 drop-down's own text look smeared next to every other text in the app.
                                 The border alone separates the list from what is behind it, the same
                                 trade the window frame (WindowChrome below) already made. -->
                            <Border Background="{DynamicResource Bg.Surface}" BorderBrush="{DynamicResource Border}" BorderThickness="1"
                                    CornerRadius="{StaticResource Radius.Control}" Padding="4"
                                    MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}">
                                <ScrollViewer MaxHeight="200" VerticalScrollBarVisibility="Auto">
                                    <ItemsPresenter/>
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="BorderBrush" Value="{DynamicResource Accent}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter Property="BorderBrush" Value="{DynamicResource Accent}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- The frame every window of this app draws for itself instead of letting Windows draw a light
         native title bar around a dark app. No Effect and no margin: this used to leave 8 px of room
         for a drawn shadow, but no window draws one any more (the opaque path gets its shadow from
         the window manager, and rasterizing a per-frame blur just to cache it cost more than the
         shadow was worth). Empty room around the frame is not free - it shows as a band of window
         background around the rounded chrome that looks like a border and answers to nothing. -->
    <Style x:Key="WindowChrome" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Bg.Window}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Border.Window}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="{StaticResource Radius.Window}"/>
    </Style>

    <Style x:Key="AiUsageButton" TargetType="Button">
        <Setter Property="Background" Value="{DynamicResource Bg.Raised}"/>
        <Setter Property="Foreground" Value="{DynamicResource Text.Primary}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Border.Control}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="12,8"/>
        <Setter Property="FontFamily" Value="{DynamicResource Font.Ui}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Root"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{StaticResource Radius.Control}"
                            Padding="{TemplateBinding Padding}"
                            TextElement.Foreground="{TemplateBinding Foreground}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Root" Property="Opacity" Value="0.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="AiUsageQuietButton" TargetType="Button">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource Text.Primary}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="8,4"/>
        <Setter Property="FontFamily" Value="{DynamicResource Font.Ui}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Border x:Name="Root" Background="{TemplateBinding Background}"
                                CornerRadius="{StaticResource Radius.Control}"
                                Padding="{TemplateBinding Padding}"
                                TextElement.Foreground="{TemplateBinding Foreground}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/>
                        </Border>
                        <Border x:Name="Focus" CornerRadius="{StaticResource Radius.Control}" BorderThickness="1"
                                BorderBrush="{DynamicResource Accent}" Visibility="Collapsed"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource Bg.Raised}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Focus" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Root" Property="Opacity" Value="0.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Same geometry as AiUsageButton, but Level.Crit at rest and on hover instead of the neutral
         palette - for a destructive confirm action so it reads as visually distinct from a plain
         Cancel button. The hover fill is a second Border layered over the root, shown/hidden via
         Visibility rather than an inline-opacity brush: a DynamicResource brush cannot carry its own
         Opacity override in a Setter, and this keeps the border/text at full opacity on hover since
         only the overlay Border itself is faded. -->
    <Style x:Key="AiUsageDangerButton" TargetType="Button">
        <Setter Property="Background" Value="{DynamicResource Bg.Raised}"/>
        <Setter Property="Foreground" Value="{DynamicResource Level.Crit}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Level.Crit}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="12,8"/>
        <Setter Property="FontFamily" Value="{DynamicResource Font.Ui}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Root"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{StaticResource Radius.Control}"
                            Padding="{TemplateBinding Padding}"
                            TextElement.Foreground="{TemplateBinding Foreground}">
                        <Grid>
                            <Border x:Name="HoverFill" Background="{DynamicResource Level.Crit}" Opacity="0.12"
                                    CornerRadius="{StaticResource Radius.Control}" Margin="-1" Visibility="Collapsed"/>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="HoverFill" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Root" Property="Opacity" Value="0.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
