<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Dark (neutral grey). -->
    <SolidColorBrush x:Key="Bg.Base" Color="#18181B"/>
    <SolidColorBrush x:Key="Bg.Surface" Color="#202023"/>
    <SolidColorBrush x:Key="Bg.Raised" Color="#28282C"/>
    <SolidColorBrush x:Key="Border" Color="#3A3A3F"/>
    <SolidColorBrush x:Key="Border.Window" Color="#0E0E10"/>
    <SolidColorBrush x:Key="Border.Control" Color="#71717B"/>
    <SolidColorBrush x:Key="Track" Color="#353539"/>
    <Thickness x:Key="Track.BorderThickness">0</Thickness>
    <SolidColorBrush x:Key="Text.Primary" Color="#F4F4F5"/>
    <SolidColorBrush x:Key="Text.Secondary" Color="#B4B4BA"/>
    <SolidColorBrush x:Key="Text.Muted" Color="#8E8E95"/>
    <SolidColorBrush x:Key="Accent" Color="#60A5FA"/>
    <SolidColorBrush x:Key="Accent.Hover" Color="#93C5FD"/>
    <SolidColorBrush x:Key="Level.Ok" Color="#34D399"/>
    <SolidColorBrush x:Key="Level.Warn" Color="#FBBF24"/>
    <SolidColorBrush x:Key="Level.Crit" Color="#F87171"/>
    <!-- Usage bar fill: same flat level color at the left, 15% lighter at the right. -->
    <LinearGradientBrush x:Key="Level.Ok.Fill" StartPoint="0,0.5" EndPoint="1,0.5">
        <GradientStop Color="#34D399" Offset="0"/>
        <GradientStop Color="#52DAA8" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="Level.Warn.Fill" StartPoint="0,0.5" EndPoint="1,0.5">
        <GradientStop Color="#FBBF24" Offset="0"/>
        <GradientStop Color="#FCC945" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="Level.Crit.Fill" StartPoint="0,0.5" EndPoint="1,0.5">
        <GradientStop Color="#F87171" Offset="0"/>
        <GradientStop Color="#F98686" Offset="1"/>
    </LinearGradientBrush>
    <Color x:Key="Shadow">#80000000</Color>
    <!-- WPF's text stack mismeasures the OS's newer, variable-weight Segoe build and clips
         descenders (g, j, y, q) in a TextBox; the classic static Segoe UI renders those correctly. -->
    <FontFamily x:Key="Font.Ui">Segoe UI, Arial</FontFamily>
    <FontFamily x:Key="Font.Numeric">Segoe UI, Arial</FontFamily>
</ResourceDictionary>
